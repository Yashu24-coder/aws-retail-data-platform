# Copy to .env and adjust. Local mode needs none of these.
PLATFORM_MODE=local          # local | aws
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=000000000000

# Buckets created by Terraform (infra/terraform)
BUCKET_RAW=retail-platform-raw
BUCKET_CURATED=retail-platform-curated

# Catalog and query services
GLUE_DATABASE=retail_platform
ATHENA_WORKGROUP=retail-analysts
REDSHIFT_WORKGROUP=retail-bi
REDSHIFT_DATABASE=analytics

# Demo data generator
PLATFORM_SEED=42
PLATFORM_DAYS=420
